# 環境変数の見本です。このファイルを .env として複製し、値を埋めてください。
# .env は追跡対象外です。値をリポジトリへ入れません。
#
# ここには「実際に使っている変数」だけを書きます。
# 機能を実装するたびに、その issue で必要な変数を追記します。

# ── アプリケーションの環境 ─────────────────────────────
# development / test / production のいずれかです。
APP_ENV=development

# ── データベース ───────────────────────────────────────
POSTGRES_USER=hero
POSTGRES_PASSWORD=
POSTGRES_DB=hero_prompt_forge_development
DATABASE_URL=postgres://hero:ここにパスワード@db:5432/hero_prompt_forge_development
TEST_DATABASE_URL=postgres://hero:ここにパスワード@db:5432/hero_prompt_forge_test

# ── Rails ─────────────────────────────────────────────
RAILS_MAX_THREADS=5

# ── フロントエンド ─────────────────────────────────────
# ブラウザから見える値です。秘匿値をここに置きません。
NEXT_PUBLIC_APP_ENV=development

# ── フォロワー判定サービス（x-follower-gate） ───────────
# 判定サービスのドメインは公開しません。ここに値を書かないでください。
FOLLOWER_GATE_BASE_URL=
FOLLOWER_GATE_CLIENT_ID=
FOLLOWER_GATE_CREDENTIAL=

# ── X ログイン（OAuth 2.0 + PKCE） ─────────────────────
# 値をここに書かないでください。
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
