# 環境変数の見本です。このファイルを .env として複製し、値を埋めてください。
# .env は追跡対象外です。値をリポジトリへ入れません。
#
# ここには「実際に使っている変数」だけを書きます。
# 機能を実装するたびに、その issue で必要な変数を追記します。

# ── アプリケーションの環境 ─────────────────────────────
# development / test / production のいずれかです。
APP_ENV=development

# ── データベース ───────────────────────────────────────
POSTGRES_USER=hero
POSTGRES_PASSWORD=
POSTGRES_DB=hero_prompt_forge_development
DATABASE_URL=postgres://hero:ここにパスワード@db:5432/hero_prompt_forge_development
TEST_DATABASE_URL=postgres://hero:ここにパスワード@db:5432/hero_prompt_forge_test

# ── Rails ─────────────────────────────────────────────
RAILS_MAX_THREADS=5

# ── フロントエンド ─────────────────────────────────────
# ブラウザから見える値です。秘匿値をここに置きません。
NEXT_PUBLIC_APP_ENV=development

# ── フォロワー判定サービス（x-follower-gate） ───────────
# 判定サービスのドメインは公開しません。ここに値を書かないでください。
FOLLOWER_GATE_BASE_URL=
FOLLOWER_GATE_CLIENT_ID=
FOLLOWER_GATE_CREDENTIAL=

# ── X ログイン（OAuth 2.0 + PKCE） ─────────────────────
# 値をここに書かないでください。
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=

# ── 開発環境の自動ログイン ─────────────────────────────
# 開発・テスト環境でのみ有効です。本番では設定しても無効です。
# 指定した X のユーザーIDの利用者として扱います。空欄なら無効です。
DEVELOPMENT_AUTO_LOGIN_X_USER_ID=

# ── 画面側の場所 ───────────────────────────────────────
# ログインの後に戻す先です。
FRONTEND_BASE_URL=http://localhost:3300

# ── 開発者用の管理画面（BASIC 認証） ───────────────────
# 値をここに書かないでください。
# **未設定のままでは管理画面が開けません。** 空で通す作りにしていません。
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# ── LLM による精緻化（Gemini） ─────────────────────────
# **値をここに書かないでください。**
# 未設定のままでも動きます。その場合は呼び出さずに縮退し、印を残します。
# **有償の呼び出しです。** 使う前に単価の見積もりを提示してください。
# **無償枠は入力が学習に使われる場合があります。有償の枠でご利用ください。**
GEMINI_API_KEY=

# ── Bot 対策（reCAPTCHA v3） ───────────────────────────
# **値をここに書かないでください。**
# **本番では必須です。** 未設定のまま本番を動かすと、その場で失敗します。
# 開発・テストでは、設定されているときだけ照合します。未設定なら飛ばします。
RECAPTCHA_SECRET_KEY=

# サイト鍵です。**ブラウザから見える値**ですので、秘匿値ではありません。
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── 待ち受ける番号 ─────────────────────────────────────
# Railway が注入します。手元では未設定で構いません（既定は 3000 です）。
PORT=
