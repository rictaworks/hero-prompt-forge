{
  "name": "hero-prompt-forge-dev-tools",
  "private": true,
  "description": "開発用の道具置き場です。アプリケーションの実装は src/ にあります。",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:hardcode": "node --test test/hardcode/*.test.mjs",
    "test:hooks": "node --test test/hooks/*.test.mjs",
    "check:hardcode": "node test/hardcode/check-hardcoded-strings.mjs ."
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.62.1"
  }
}
